{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!!**/.direnv", "!!**/node_modules", "!!**/@girs"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "assist": { "actions": { "preset": "recommended" }, "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": "off",
        "useButtonType": "off"
      },
      "complexity": {
        "noUselessFragments": "off"
      },
      "correctness": {
        "useJsxKeyInIterable": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off"
      },
      "suspicious": {
        "noConsole": "off",
        "noDeprecatedImports": "error",
        "noReactSpecificProps": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNamingConvention": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["theme/**/*.scss"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnknownProperty": {
              "level": "error",
              "options": {
                "ignore": ["-gtk-icon-size", "-gtk-icon-style"]
              }
            },
            "noUnknownTypeSelector": "off"
          }
        }
      }
    }
  ]
}
